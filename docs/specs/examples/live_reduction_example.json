  "usage_example": {
    "scenario": "3층 기둥, 사무실, 부하면적 18m²",
    "steps": [
      {"step": "영향면적 배수 조회", "query": "primary_key='column_foundation'", "result": 4},
      {"step": "영향면적 계산", "calc": "A = 18 × 4 = 72m²"},
      {"step": "최소면적 확인", "query": "primary_key='min_influence_area'", "result": "36m²", "check": "72 ≥ 36 → 저감 가능"},
      {"step": "저감계수 산정", "calc": "C = 0.3 + 4.2/√72 = 0.3 + 0.495 = 0.795"},
      {"step": "하한 확인", "query": "primary_key='min_factor_2plus_floors'", "result": 0.4, "check": "0.795 ≥ 0.4 → OK"},
      {"step": "예외 확인", "query": "param_subtype='exceptions'", "check": "office ≠ assembly, parking → 예외 아님"},
      {"step": "최종", "result": "저감계수 C = 0.795, 저감 활하중 = 2.5 × 0.795 = 1.99 kN/m²"}
    ]
  }
