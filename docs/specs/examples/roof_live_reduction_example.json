{
  "_comment": "roof_live_reduction view 레코드 예시 — 지붕활하중 저감 (절 3.6)",
  "view": "public.roof_live_reduction",
  "filter": "param_type='roof_live_reduction'",

  "records": [
    {
      "param_type": "roof_live_reduction",
      "param_subtype": "formula",
      "primary_key": "L",
      "secondary_key": null,
      "value": null,
      "value_min": 0.6,
      "value_max": 1.0,
      "unit": "kN/m²",
      "conditions": [
        {"variable": "L", "description": "저감된 지붕활하중", "unit": "kN/m²"},
        {"variable": "Lo", "description": "수평투영면적에 대한 지붕활하중", "unit": "kN/m²"},
        {"variable": "R1", "description": "부하면적(At)에 따른 저감계수"},
        {"variable": "R2", "description": "경사 물매(F)에 따른 저감계수"},
        {"bound": "0.6 ≤ R1×R2 ≤ 1.0"}
      ],
      "notes": "L = Lo × R1 × R2 (식 3.6-1). value_min/max는 R1×R2 허용 범위",
      "code_id": "KDS 41 12 00",
      "clause_id": "3.6.1"
    },
    {
      "param_type": "roof_live_reduction",
      "param_subtype": "by_area",
      "primary_key": "R1",
      "secondary_key": "At_20_60",
      "value": null,
      "value_min": 20.0,
      "value_max": 60.0,
      "unit": "m²",
      "conditions": [{"range": "20.0 m² < At < 60.0 m²", "formula": "R1 = 1.2 - 0.01 × At", "R1_at_20": 1.0, "R1_at_60": 0.6}],
      "notes": "R1 = 1.2 - 0.01 × At. At=20→R1=1.0, At=60→R1=0.6 (선형 보간)",
      "code_id": "KDS 41 12 00",
      "clause_id": "3.6.1"
    },
    {
      "param_type": "roof_live_reduction",
      "param_subtype": "by_slope",
      "primary_key": "R2",
      "secondary_key": "F_1_3_1",
      "value": null,
      "value_min": 0.333,
      "value_max": 1.0,
      "unit": "-",
      "conditions": [{"range": "1/3 < F < 1", "formula": "R2 = 1.2 - 0.6 × F", "R2_at_1_3": 1.0, "R2_at_1": 0.6}],
      "notes": "R2 = 1.2 - 0.6 × F. F=1/3→R2=1.0, F=1→R2=0.6 (선형 보간)",
      "code_id": "KDS 41 12 00",
      "clause_id": "3.6.1"
    },
    {
      "param_type": "roof_live_reduction",
      "param_subtype": "by_area",
      "primary_key": "R1",
      "secondary_key": "At_ge_60",
      "value": 0.6,
      "value_min": 60.0,
      "value_max": null,
      "unit": "m²",
      "conditions": [{"range": "At ≥ 60.0 m²", "R1": 0.6}],
      "notes": "부하면적 60m² 이상: 최대 저감",
      "code_id": "KDS 41 12 00",
      "clause_id": "3.6.1"
    }
  ],

  "usage_example": {
    "scenario": "지붕 부하면적 45m², 물매 F=0.5 (경사지붕)",
    "steps": [
      {"step": "Lo 확인", "query": "live_load WHERE primary_key='roof'", "result": "Lo = 1.0 kN/m²"},
      {"step": "R1 구간 판별", "calc": "At=45 → 20 < 45 < 60 → secondary_key='At_20_60'"},
      {"step": "R1 계산", "formula": "R1 = 1.2 - 0.01 × 45 = 0.75"},
      {"step": "R2 구간 판별", "calc": "F=0.5 → 1/3 < 0.5 < 1 → secondary_key='F_1_3_1'"},
      {"step": "R2 계산", "formula": "R2 = 1.2 - 0.6 × 0.5 = 0.90"},
      {"step": "L 계산", "calc": "L = 1.0 × 0.75 × 0.90 = 0.675"},
      {"step": "범위 확인", "check": "0.6 ≤ 0.675 ≤ 1.0 → OK"},
      {"step": "최종", "result": "저감된 지붕활하중 = 0.675 kN/m²"}
    ]
  }
}
